APP_NAME=Convite
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8000

APP_LOCALE=es
APP_FALLBACK_LOCALE=es
APP_FAKER_LOCALE=es_MX

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=convite
DB_USERNAME=yazito
DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"

# WhatsApp number used by the landing page's contact CTAs.
# Country code + number, digits only (no spaces, no "+"). Example: 523321852205
VITE_CONTACT_WHATSAPP=

# Google Analytics (GA4) measurement ID.
VITE_GA_ID=

# Prices (MXN) of the services page (/servicios). Leave empty for the defaults in
# resources/js/app/lib/services.ts. Read at build time: run `npm run build` after changing them.
VITE_PRICE_TRIBUTE_VIDEO=
VITE_PRICE_TRIBUTE_VIDEO_PREMIUM=
VITE_PRICE_VIDEO_INVITATION=
VITE_PRICE_CARD=
VITE_PRICE_PASSES=
VITE_PRICE_CARD_AND_PASSES=
# Passes included in the passes' price, and the price of each further block of as many.
VITE_PASSES_INCLUDED=
VITE_PRICE_EXTRA_PASSES=
CONVITE_GUEST_RETENTION_DAYS=30
CONVITE_OPEN_RSVP_MAX_SEATS=5
CONVITE_DEFAULT_PHONE_COUNTRY_CODE=52
CONVITE_REFERRALS_ENABLED=true
CONVITE_REFERRAL_DISCOUNT_PERCENT=10
CONVITE_REFERRAL_COOKIE_DAYS=60
CONVITE_PARTNER_COOKIE_DAYS=60
